# Copy to .env.local and fill in. The same keys go in Vercel project settings (per environment).

# Firebase web app config (public; restrict the API key by HTTP referrer in Google Cloud Console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# App Check (reCAPTCHA Enterprise site key). Empty disables App Check.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# 1 = use the local Emulator Suite (project demo-tapik). Must be empty or 0 in production.
NEXT_PUBLIC_USE_EMULATORS=
# mock | firebase. Which data source the service layer uses while the migration is in progress.
NEXT_PUBLIC_DATA_SOURCE=

# Server only. Never NEXT_PUBLIC_, never committed.
# Optional. Base64 of a service account key JSON. Leave empty to use keyless Application
# Default Credentials (local: gcloud auth application-default login; Vercel: Workload Identity).
FIREBASE_SERVICE_ACCOUNT_JSON=
# http://localhost:3000 locally, https://tapik.ph in production.
APP_BASE_URL=
# Shared secret for POST /api/revalidate (header x-revalidate-secret). Generate: openssl rand -base64 32
REVALIDATE_SECRET=
