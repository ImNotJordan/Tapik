APP_BASE_URL=https://tapik.vercel.app
# A local dev server talking to production may also receive links.
APP_ALLOWED_ORIGINS=http://localhost:3000
ENFORCE_APP_CHECK=false
# Email (functions/src/send-mail.ts). true once SMTP_PASSWORD is set as a secret:
#   firebase functions:secrets:set SMTP_PASSWORD --project tapik-ph
# Until then, "Send invite" asks for Copy link and nothing is emailed.
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
MAIL_FROM=
